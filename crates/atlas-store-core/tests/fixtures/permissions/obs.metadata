[Application]
name=com.obsproject.Studio
runtime=org.kde.Platform/x86_64/6.8
sdk=org.kde.Sdk/x86_64/6.8
command=obs

[Context]
shared=network;ipc;
sockets=x11;pulseaudio;wayland;
devices=all;
filesystems=xdg-run/pipewire-0;xdg-videos;home;
persistent=.config/obs-studio;

[Session Bus Policy]
org.kde.StatusNotifierWatcher=talk
org.freedesktop.Flatpak=talk

[Environment]
QT_QPA_PLATFORM=xcb
