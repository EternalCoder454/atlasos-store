[Application]
name=org.gimp.GIMP
runtime=org.gnome.Platform/x86_64/47
sdk=org.gnome.Sdk/x86_64/47
command=gimp

[Context]
shared=ipc;
sockets=x11;wayland;fallback-x11;
devices=dri;
filesystems=xdg-pictures;xdg-documents;xdg-download;xdg-config/GIMP;xdg-config/gtk-3.0:ro;
persistent=.config/GIMP;

[Session Bus Policy]
org.gtk.vfs.*=talk
org.freedesktop.portal.Fcitx=talk
