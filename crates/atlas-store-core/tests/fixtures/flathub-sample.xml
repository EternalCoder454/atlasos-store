      <release timestamp="1784764800" type="stable" version="0.8.4">
        <description>
          <p>Backend-managed settings and credentials with OS keyring support, native web_search/web_fetch via tauri-plugin-websearch, built-in extension bundling, per-model chat template kwargs, OpenAI-compatible translating gateway with Responses API, chain-of-thought duration persistence, MCP duplicate serve guard, multi-provider API key rotation, and a large batch of chat, RAG, and desktop fixes</p>
        </description>
      </release>
      <release timestamp="1782259200" type="stable" version="0.8.3">
        <description>
          <p>A visible assistant switcher with a Cmd/Ctrl+J cycle shortcut, a unified reasoning and tool-call trace timeline, per-model sampling defaults for the local API server, a larger 100MB attachment limit, plus a batch of chat, citation, markdown/LaTeX rendering, factory-reset, and Linux fixes</p>
        </description>
      </release>
      <release timestamp="1780272000" type="stable" version="0.8.2">
        <description>
          <p>Experimental AMD ROCm/HIP backend on Linux, a branded phased-startup loader with faster first paint, pause/resume model downloads, a safer default context size, and a batch of chat, provider, and toast fixes</p>
        </description>
      </release>
      <release timestamp="1780012800" type="stable" version="0.8.1">
        <description>
          <p>Anthropic-compatible custom providers, provider-aware sampling controls, media-only messages, an overhauled llama.cpp settings UX, and many stability and error-handling fixes</p>
        </description>
      </release>
    </releases>
