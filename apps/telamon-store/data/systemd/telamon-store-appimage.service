# Started by telamon-store-appimage.path. Looks for AppImages that just
# arrived in Downloads, tells the user once ("Install <App>?") and exits. It
# never runs an AppImage and never opens the network; the Store itself is
# started only when the user presses a button on the notification.
[Unit]
Description=Tell the user about a downloaded AppImage
Documentation=https://github.com/EternalCoder454/atlasos-store
# A burst of changes in Downloads (an unpack, a torrent) starts it many times in
# a few seconds; it must not be given up on, so no start limit.
StartLimitIntervalSec=0

[Service]
Type=oneshot
ExecStart=/usr/bin/telamon-store --appimage-check %h/Downloads
# Waits for downloads to finish and for answers. The check stops starting work
# after 8 minutes and ends itself after 10 (check::DEADLINE); this is a minute
# more than that.
TimeoutStartSec=11min
Nice=10
IOSchedulingClass=idle
NoNewPrivileges=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictAddressFamilies=AF_UNIX
SystemCallArchitectures=native
MemoryMax=2G
# Hardening that is a seccomp filter, a limit or a keyring and so needs nothing
# from the kernel that a user manager may lack. The inspection helper and gpgv
# this service starts inherit all of it.
# No new namespaces for it or what it starts (the helper and gpgv need none).
RestrictNamespaces=yes
# No file with the set-user-ID or set-group-ID bit is created.
RestrictSUIDSGID=yes
# Its own kernel keyring, not the login session's.
KeyringMode=private
# What it creates is the user's alone; the files it keeps say their own mode.
UMask=0077
# No core file of a helper that crashed on a stranger's file.
LimitCORE=0
# Itself, the inspection helper, gpgv and systemd-run, one at a time.
TasksMax=64
# Deliberately not set, so that the unit keeps working where the kernel or the
# user manager lacks what they need: ProtectSystem=, ProtectHome=, PrivateTmp=,
# ProtectKernel*=, ProtectControlGroups=, ProtectClock=, ProtectHostname=,
# PrivateNetwork= and CapabilityBoundingSet= (all of them set up namespaces or
# capabilities a user unit gets only through an implied user namespace; and a
# user unit has no capability to give up), SystemCallFilter= (it would be
# inherited by the helper, which installs a seccomp filter of its own) and
# MemoryDenyWriteExecute= (the binary links Qt).
