[Desktop Entry]
Type=Application
Name=Telamon Store
GenericName=App Store
Comment=Find, install and update apps
Exec=telamon-store %U
Icon=net.eterneon.telamon.store
Terminal=false
Categories=Qt;KDE;System;PackageManager;
Keywords=software;apps;install;flatpak;flathub;store;updates;discover;
# Flatpak's files, its links, AppStream links (Plasma's "Uninstall or Manage
# Add-Ons" and KRunner), RPM files, which the Store explains instead of
# installing, and AppImages, which it looks inside (never runs) and asks
# about before installing.
MimeType=application/vnd.flatpak.ref;application/vnd.flatpak.repo;application/vnd.flatpak;application/x-rpm;application/vnd.appimage;application/x-iso9660-appimage;x-scheme-handler/appstream;x-scheme-handler/flatpak+https;
StartupNotify=true
SingleMainWindow=true
X-KDE-StartupNotify=true
Actions=Updates;

[Desktop Action Updates]
Name=Updates
Exec=telamon-store --page updates
