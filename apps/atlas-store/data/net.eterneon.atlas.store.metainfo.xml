<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>net.eterneon.atlas.store</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MIT</project_license>
  <name>Atlas Store</name>
  <summary>Find, install and update apps</summary>
  <description>
    <p>Atlas Store is the app store of AtlasOS. Browse and search the apps on Flathub and your other Flatpak sources, see their screenshots, what they can access and who made them, and install, update and remove them.</p>
    <p>It shows what an app may access before you install it, and never adds a source or installs anything without asking you first. When it is closed, nothing of it runs: Atlas Updater checks for updates in the background.</p>
  </description>
  <launchable type="desktop-id">net.eterneon.atlas.store.desktop</launchable>
  <url type="homepage">https://github.com/EternalCoder454/AtlasOS</url>
  <url type="vcs-browser">https://github.com/EternalCoder454/atlasos-store</url>
  <url type="bugtracker">https://github.com/EternalCoder454/atlasos-store/issues</url>
  <developer id="net.eterneon">
    <name>Eterneon</name>
  </developer>
  <categories>
    <category>System</category>
    <category>PackageManager</category>
  </categories>
  <provides>
    <binary>atlas-store</binary>
  </provides>
  <content_rating type="oars-1.1"/>
  <supports>
    <control>pointing</control>
    <control>keyboard</control>
    <control>touch</control>
  </supports>
  <releases>
    <release version="0.1.0" date="2026-10-05"/>
  </releases>
</component>
